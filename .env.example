# Provider selection. "mock" (default) needs no key and runs the full
# pipeline deterministically offline. Set to "openai" or "anthropic" for a
# real-LLM run (see docs/evaluation.md for what changes and why it matters).
PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5
