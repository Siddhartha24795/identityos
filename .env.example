# Provider selection. "mock" (default) needs no key and runs the full
# pipeline deterministically offline. Set to "openai", "anthropic", or
# "groq" for a real-LLM run (see docs/evaluation.md for what changes and
# why it matters). "groq" is free, no credit card required — get a key at
# https://console.groq.com/keys — and is the easiest way to see real
# model quality without paying for one.
PROVIDER=mock

OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5

GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
# "low"/"medium"/"high", or "" to omit the parameter for a non-reasoning
# model. Measured directly (docs/evaluation.md): the API's own default
# ("high") burns most of max_tokens on hidden reasoning for this
# project's short, structured completions, truncating answers; "low" was
# verified to answer completely and correctly using far fewer tokens.
GROQ_REASONING_EFFORT=low

# Browser agent (v3) contact-routing field. Left empty here on purpose —
# services/browser_engine/field_mapper.py falls back to a synthetic
# placeholder (identityos.demo@example.com) when this is unset, which is
# what every committed trajectory/eval artifact in this repo was generated
# with. Set your real address here (.env is gitignored, never committed)
# if you want the browser agent to fill your actual email in a real run.
APPLICANT_EMAIL=
